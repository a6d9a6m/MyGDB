# Copy to .env.local and fill local-only values.
#
# Required for dogapi or another OpenAI-compatible Codex provider.
# In GitHub Actions, store this as the CODEX_API_KEY secret.
CODEX_API_KEY=

# Optional: Codex provider defaults used by CI and local runs.
CODEX_MODEL_PROVIDER=dogapi
CODEX_MODEL=gpt-5.4-codex
CODEX_MODEL_REASONING_EFFORT=medium
CODEX_BASE_URL=https://www.dogapi.cc/v1

# Optional: absolute path to Codex CLI when `codex` is not on PATH.
CODEX_BIN=codex

# Optional: GitHub API token. Local runs can omit this and use unauthenticated API limits.
GITHUB_TOKEN=
