# Copy to .env.local and fill local-only values.
#
# Required when pipeline step 2 calls Codex CLI in a non-interactive environment.
OPENAI_API_KEY=

# Optional: forwarded to `codex exec --model`.
CODEX_MODEL=gpt-5.5

# Optional: absolute path to Codex CLI when `codex` is not on PATH.
CODEX_BIN=codex

# Optional: GitHub API token. Local runs can omit this and use unauthenticated API limits.
GITHUB_TOKEN=
